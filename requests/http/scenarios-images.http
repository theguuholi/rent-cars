### Reject fake JPEG contents
# @name scenarios_images_invalid_upload
# @tag negative
PATCH {{baseUrl}}/cars/{{state.carId}}/images
Authorization: Bearer {{state.adminToken}}
Content-Type: multipart/form-data; boundary=CarImageBoundary

--CarImageBoundary
Content-Disposition: form-data; name="images"; filename="invalid-image.jpg"
Content-Type: image/jpeg

< ../fixtures/invalid-image.jpg
--CarImageBoundary--

{{
  const assert = require("node:assert/strict");
  assert.equal(response.statusCode, 422);
}}
