# @import ./common.http

### Request a password reset for the example driver
# @name password_recovery_request
# @forceRef csrf
POST {{baseUrl}}/password-recovery
X-XSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"email":"{{driverEmail}}"}

{{
  const assert = require("node:assert/strict");
  test("Request accepted without exposing the account", () => assert.equal(response.statusCode, 202));
}}

### Find the example driver's message in local Mailpit
# @name password_recovery_mailbox
GET {{mailpitUrl}}/api/v1/messages

{{
  const assert = require("node:assert/strict");
  assert.equal(response.statusCode, 200);
  const message = response.parsedBody.messages.find(item => item.To.some(to => to.Address === driverEmail));
  assert.ok(message, "Run auth_register_driver and password_recovery_request first");
  state.resetMessageId = message.ID;
}}

### Capture the one-time token from the local email
# @name password_recovery_message
GET {{mailpitUrl}}/api/v1/message/{{state.resetMessageId}}

{{
  const assert = require("node:assert/strict");
  assert.equal(response.statusCode, 200);
  const link = response.parsedBody.Text.match(/reset-password\?token=([A-Za-z0-9_-]+)/);
  assert.ok(link, "Reset link missing from the message");
  state.resetToken = link[1];
}}

### Choose a new password (the link works only once)
# @name password_recovery_reset
# @forceRef csrf
POST {{baseUrl}}/password-recovery/reset
X-XSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"token":"{{state.resetToken}}","password":"replacement-password-123","passwordConfirmation":"replacement-password-123"}

{{
  const assert = require("node:assert/strict");
  test("Password changed", () => assert.equal(response.statusCode, 204));
}}

### Reusing the link is rejected
# @name password_recovery_replay
# @forceRef csrf
POST {{baseUrl}}/password-recovery/reset
X-XSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{"token":"{{state.resetToken}}","password":"another-password-123","passwordConfirmation":"another-password-123"}

{{
  const assert = require("node:assert/strict");
  test("Consumed token rejected", () => assert.equal(response.statusCode, 400));
}}
