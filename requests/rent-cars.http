@baseUrl = http://localhost:8080
@adminEmail = test@test
@adminPassword = test@tesT@dev
@driverEmail = driver@example.com
@driverPassword = local-example-only-123

# Start with make api-dev. Click Send Request above each numbered request.
# Steps 1–8 only read data or sign you in. The optional exercises modify local data.

### 1. Browse the public fleet → 200
# @name listCars
GET {{baseUrl}}/cars

### 2. Read the first car with its category and equipment → 200 (skip if the fleet is empty)
GET {{baseUrl}}/cars/{{listCars.response.body.$[0].id}}

### 3. Get the CSRF header and cookie → 204 (an empty body is expected)
# @name csrf
GET {{baseUrl}}/csrf

### 4. Sign in as the seeded admin → 200 (accessToken)
# @name login
POST {{baseUrl}}/sessions
Content-Type: application/json
X-XSRF-TOKEN: {{csrf.response.headers.X-XSRF-TOKEN}}
Cookie: XSRF-TOKEN={{csrf.response.headers.X-XSRF-TOKEN}}

{"email":"{{adminEmail}}","password":"{{adminPassword}}"}

### 5. Check your identity → 200 (role ADMIN)
GET {{baseUrl}}/sessions/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### 6. List categories with the login token → 200
# @name categories
GET {{baseUrl}}/categories
Authorization: Bearer {{login.response.body.$.accessToken}}

### 7. List specifications with the same token → 200
# @name listSpecifications
GET {{baseUrl}}/specifications
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### 8. Read the first specification → 200 (skip if the list is empty)
GET {{baseUrl}}/specifications/{{listSpecifications.response.body.$[0].id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Optional · Create the example specification; continue after receiving 201 Created
# @name createSpecification
POST {{baseUrl}}/specifications
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{"name":"air conditioning","description":"Cabin temperature control."}

### Optional · Fetch the specification created above
GET {{baseUrl}}/specifications/{{createSpecification.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Optional · Update both fields of the example specification
# @name updateSpecification
PUT {{baseUrl}}/specifications/{{createSpecification.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{"name":"climate control","description":"Automatic cabin temperature control.","expectedVersion":{{createSpecification.response.body.$.version}}}

### Optional · Change only its description
PATCH {{baseUrl}}/specifications/{{createSpecification.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{"description":"Dual-zone climate control.","expectedVersion":{{updateSpecification.response.body.$.version}}}

### Optional · Delete the specification created above
DELETE {{baseUrl}}/specifications/{{createSpecification.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Optional · Register the example car; continue after receiving 201 Created
# Use an unused license plate. Use [] to register without specifications.
# @name createCar
POST {{baseUrl}}/cars
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Argo",
  "brand": "Fiat",
  "description": "Five-door hatchback.",
  "licensePlate": "abc1d23",
  "dailyRateCents": 15050,
  "fineAmountCents": 0,
  "categoryId": "{{categories.response.body.$[0].id}}",
  "specificationIds": ["{{listSpecifications.response.body.$[0].id}}"]
}

### Optional · Fetch the car registered above
GET {{baseUrl}}/cars/{{createCar.response.body.$.id}}

### Optional · Mark that car unavailable and clear its specifications
PATCH {{baseUrl}}/cars/{{createCar.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{"available":false,"specificationIds":[],"expectedVersion":{{createCar.response.body.$.version}}}

### Optional · Delete the car registered above
DELETE {{baseUrl}}/cars/{{createCar.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Optional · Register a separate USER account (once per email) → 201
POST {{baseUrl}}/users
Content-Type: application/json
X-XSRF-TOKEN: {{csrf.response.headers.X-XSRF-TOKEN}}
Cookie: XSRF-TOKEN={{csrf.response.headers.X-XSRF-TOKEN}}

{"email":"{{driverEmail}}","password":"{{driverPassword}}"}

### Renew this device session (enable REST Client's cookie jar and run steps 3 and 4 first)
# @name refresh
POST {{baseUrl}}/sessions/refresh
X-XSRF-TOKEN: {{csrf.response.headers.X-XSRF-TOKEN}}

### Verify the renewed access token
GET {{baseUrl}}/sessions/me
Authorization: Bearer {{refresh.response.body.$.accessToken}}

### End this device session
DELETE {{baseUrl}}/sessions/current
X-XSRF-TOKEN: {{csrf.response.headers.X-XSRF-TOKEN}}

### Upload example 1. Create a car and two images in one request → 201
# Requires the login and categories requests above. Delete the example car before repeating.
# The JSON part must use application/json. File paths are relative to this .http file.
# @name createCarWithImages
POST {{baseUrl}}/cars
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: multipart/form-data; boundary=CarImageBoundary

--CarImageBoundary
Content-Disposition: form-data; name="car"
Content-Type: application/json

{"name":"Photo example","description":"Car with two uploaded images","brand":"Fiat","licensePlate":"IMG1A23","dailyRateCents":15000,"fineAmountCents":0,"categoryId":"{{categories.response.body.$[0].id}}"}
--CarImageBoundary
Content-Disposition: form-data; name="images"; filename="car-front.png"
Content-Type: image/png

< ./fixtures/car-front.png
--CarImageBoundary
Content-Disposition: form-data; name="images"; filename="car-side.png"
Content-Type: image/png

< ./fixtures/car-side.png
--CarImageBoundary--

### Upload example 2. Read the car and its image identifiers → 200
# @name uploadedCar
GET {{baseUrl}}{{createCarWithImages.response.headers.Location}}

### Upload example 3. Read an image without authentication → 200 image/png
GET {{baseUrl}}/cars/{{uploadedCar.response.body.$.id}}/images/{{uploadedCar.response.body.$.images[0].id}}

### Upload example 4. Remove the first image as admin → 204
# Metadata disappears immediately; background cleanup removes the stored bytes.
DELETE {{baseUrl}}/cars/{{uploadedCar.response.body.$.id}}/images/{{uploadedCar.response.body.$.images[0].id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Upload example 5. Remove the example car and queue remaining images for cleanup → 204
DELETE {{baseUrl}}/cars/{{uploadedCar.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Upload example 6. Reject a fake JPEG without creating a car → 422
POST {{baseUrl}}/cars
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: multipart/form-data; boundary=InvalidImageBoundary

--InvalidImageBoundary
Content-Disposition: form-data; name="car"
Content-Type: application/json

{"name":"Invalid photo","description":"Must not be created","brand":"Fiat","licensePlate":"IMG9Z99","dailyRateCents":15000,"fineAmountCents":0,"categoryId":"{{categories.response.body.$[0].id}}"}
--InvalidImageBoundary
Content-Disposition: form-data; name="images"; filename="fake.jpg"
Content-Type: image/jpeg

This is not a JPEG image.
--InvalidImageBoundary--
