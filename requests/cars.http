@baseUrl = http://localhost:8080

### Browse the fleet
# @name listCars
GET {{baseUrl}}/cars

### Inspect the first car with the IDs, names and descriptions of its category and assigned specifications (optional; run listCars first and skip if empty)
GET {{baseUrl}}/cars/{{listCars.response.body.$[0].id}}

### Start the registration example by choosing a body style
# @name categories
GET {{baseUrl}}/categories
Authorization: Bearer {{$processEnv RENT_CARS_ADMIN_TOKEN}}

### Choose a feature for the example (the dev catalog is seeded)
# @name specifications
GET {{baseUrl}}/specifications
Authorization: Bearer {{$processEnv RENT_CARS_ADMIN_TOKEN}}

### Register the example car; continue after receiving 201 Created
# Use an unused license plate. Use [] to register without specifications.
# @name createCar
POST {{baseUrl}}/cars
Authorization: Bearer {{$processEnv RENT_CARS_ADMIN_TOKEN}}
Content-Type: application/json

{
  "name": "Argo",
  "brand": "Fiat",
  "description": "Five-door hatchback.",
  "licensePlate": "abc1d23",
  "dailyRateCents": 15050,
  "fineAmountCents": 0,
  "categoryId": "{{categories.response.body.$[0].id}}",
  "specificationIds": ["{{specifications.response.body.$[0].id}}"]
}

### Fetch the car registered above
GET {{baseUrl}}/cars/{{createCar.response.body.$.id}}

### Mark that car unavailable and clear its specifications
PATCH {{baseUrl}}/cars/{{createCar.response.body.$.id}}
Authorization: Bearer {{$processEnv RENT_CARS_ADMIN_TOKEN}}
Content-Type: application/json

{"available":false,"specificationIds":[]}

### Delete the car registered above
DELETE {{baseUrl}}/cars/{{createCar.response.body.$.id}}
Authorization: Bearer {{$processEnv RENT_CARS_ADMIN_TOKEN}}
