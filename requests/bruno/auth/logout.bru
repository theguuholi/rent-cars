meta {
  name: End current device session
  type: http
  seq: 9
  tags: [
    manual
  ]
}

delete {
  url: {{baseUrl}}/sessions/current
  body: none
  auth: none
}

headers {
  X-XSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  await bru.runRequest("auth/csrf");
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.deleteVar(bru.getVar("sessionTokenName"));
    bru.deleteVar("sessionToken");
  }
}

assert {
  res.status: eq 204
}

docs {
  Run after testing. Ends the last signed-in session; issued JWTs expire separately.
}
