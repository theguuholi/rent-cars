meta {
  name: Get CSRF cookie and header
  type: http
  seq: 1
  tags: [
    helper
  ]
}

get {
  url: {{baseUrl}}/csrf
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar("csrfToken", res.getHeader("x-xsrf-token"));
  }
}

assert {
  res.status: eq 204
}

docs {
  Reused by registration, login, refresh and logout. Keep the Bruno cookie jar enabled.
}
