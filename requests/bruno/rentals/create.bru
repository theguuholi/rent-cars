meta {
  name: Rent the example car
  type: http
  seq: 1
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/rentals
  body: json
  auth: inherit
}

body:json {
  {"carId":"{{carId}}","expectedReturnDate":"{{expectedReturnDate}}"}
}

script:pre-request {
  bru.setVar("expectedReturnDate", new Date(Date.now() + 2 * 86400000).toISOString());
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("rentalId", res.getBody().id);
    bru.setVar("carVersion", res.getBody().car.version);
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Rental open and car unavailable", () => {
    expect(res.getBody().endDate).to.equal(null);
    expect(res.getBody().totalCents).to.equal(null);
    expect(res.getBody().car.available).to.equal(false);
  });
}
