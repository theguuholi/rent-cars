meta {
  name: Return rented car
  type: http
  seq: 3
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/rentals/{{rentalId}}/return
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("carVersion", res.getBody().car.version);
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Rental closed and car released", () => {
    expect(res.getBody().endDate).to.be.a("string");
    expect(res.getBody().totalCents).to.be.at.least(15000);
    expect(res.getBody().car.available).to.equal(true);
  });
}

docs {
  No body. Immediate return costs 15000 centavos; server calculates completed daily periods and fines.
}
