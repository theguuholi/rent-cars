meta {
  name: List categories and select SEDAN
  type: http
  seq: 1
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/categories
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200) {
    const category = res.getBody().find(item => item.name === "SEDAN");
    if (!category) throw new Error("SEDAN category is missing");
    bru.setVar("categoryId", category.id);
  }
}

assert {
  res.status: eq 200
}
