meta {
  name: Create example Argo
  type: http
  seq: 2
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/cars
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Argo",
    "description": "Bruno example vehicle",
    "brand": "Fiat",
    "licensePlate": "{{licensePlate}}",
    "dailyRateCents": 15000,
    "fineAmountCents": 3000,
    "categoryId": "{{categoryId}}",
    "specificationIds": ["{{specificationId}}"]
  }
}

script:pre-request {
  bru.setVar("licensePlate", "BR" + Date.now() + Math.floor(Math.random() * 10000));
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("carId", res.getBody().id);
    bru.setVar("carVersion", res.getBody().version);
  }
}

assert {
  res.status: eq 201
}
