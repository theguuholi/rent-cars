meta {
  name: Read example car and current version
  type: http
  seq: 3
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/cars/{{carId}}
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("carId", res.getBody().id);
    bru.setVar("carVersion", res.getBody().version);
  }
}

assert {
  res.status: eq 200
}
