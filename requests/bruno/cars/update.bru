meta {
  name: Update example car
  type: http
  seq: 4
  tags: [
    smoke
  ]
}

patch {
  url: {{baseUrl}}/cars/{{carId}}
  body: json
  auth: inherit
}

body:json {
  {"description":"Updated Bruno example vehicle","expectedVersion":{{carVersion}}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("carId", res.getBody().id);
    bru.setVar("carVersion", res.getBody().version);
  }
}

assert {
  res.status: eq 200
}
