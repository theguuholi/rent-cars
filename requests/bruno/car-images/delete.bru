meta {
  name: Delete captured image
  type: http
  seq: 4
  tags: [
    smoke
  ]
}

delete {
  url: {{baseUrl}}/cars/{{carId}}/images/{{imageId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Run cars/get before your next manual edit to refresh carVersion. Retains imageId to test the deleted-image scenario.
}
