meta {
  name: Append another photo
  type: http
  seq: 3
  tags: [
    smoke
  ]
}

patch {
  url: {{baseUrl}}/cars/{{carId}}/images
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  images: @file(../fixtures/car-front.png) @contentType(image/png)
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("carId", res.getBody().id);
    bru.setVar("carVersion", res.getBody().version);
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Existing photos kept", () => expect(res.getBody().images.length).to.be.at.least(3));
}
