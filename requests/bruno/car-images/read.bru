meta {
  name: Read public image bytes
  type: http
  seq: 2
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/cars/{{carId}}?imageId={{imageId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("PNG returned", () => expect(res.getHeader("content-type")).to.include("image/png"));
}
