meta {
  name: Another account rents an unavailable car
  type: http
  seq: 1
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/rentals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {"carId":"{{carId}}","expectedReturnDate":"{{expectedReturnDate}}"}
}

script:pre-request {
  bru.setVar("expectedReturnDate", new Date(Date.now() + 2 * 86400000).toISOString());
}

assert {
  res.status: eq 409
}

docs {
  Run after rentals/create and BEFORE rentals/return.
}
