meta {
  name: Reject return less than 24 hours ahead
  type: http
  seq: 4
  tags: [
    negative
  ]
}

post {
  url: {{baseUrl}}/rentals
  body: json
  auth: inherit
}

body:json {
  {"carId":"{{carId}}","expectedReturnDate":"{{invalidReturnDate}}"}
}

script:pre-request {
  bru.setVar("invalidReturnDate", new Date(Date.now() + 3600000).toISOString());
}

assert {
  res.status: eq 422
}
