meta {
  name: Replace example specification
  type: http
  seq: 4
  tags: [
    smoke
  ]
}

put {
  url: {{baseUrl}}/specifications/{{specificationId}}
  body: json
  auth: inherit
}

body:json {
  {"name":"{{specificationName}} updated","description":"Automatic climate control","expectedVersion":{{specificationVersion}}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("specificationId", res.getBody().id);
    bru.setVar("specificationVersion", res.getBody().version);
    bru.setVar("specificationName", res.getBody().name);
  }
}

assert {
  res.status: eq 200
}
