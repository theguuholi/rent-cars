meta {
  name: Create example specification
  type: http
  seq: 2
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/specifications
  body: json
  auth: inherit
}

body:json {
  {"name":"{{specificationName}}","description":"Bruno example equipment"}
}

script:pre-request {
  bru.setVar("specificationName", "Bruno AC " + Date.now());
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("specificationId", res.getBody().id);
    bru.setVar("specificationVersion", res.getBody().version);
    bru.setVar("specificationName", res.getBody().name);
  }
}

assert {
  res.status: eq 201
}
