{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "architecture": "depcruise --config .dependency-cruiser.json --include-only '^src' --exclude '(\\.test\\.|^src/test/)' src",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:public-api": "playwright test e2e/public-cars.pw.ts",
    "test:browser": "playwright test e2e/catalog-navigation.pw.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:fix": "oxlint --fix",
    "test:coverage": "vitest run --coverage",
    "dev:stack": "concurrently --kill-others --names api,web \"cd ../api && ./mvnw spring-boot:run\" \"vite --strictPort\"",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@swc/core": "1.15.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "18.6.0",
    "jsdom": "^29.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
